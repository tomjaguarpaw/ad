#!/usr/bin/env sh
set -eu

trigger=".ghcid-trigger"
output=".ghcid-output"

launch_ghcid() {
  ghcid --ignore-loaded --reload="$trigger" --outputfile="$output" --no-height-limit "$@"
}

wait_for_output() {
  trigger_time=$(stat -c %Y "$trigger" 2>/dev/null || stat -f %m "$trigger")
  while :; do
    if [ -f "$output" ]; then
      output_time=$(stat -c %Y "$output" 2>/dev/null || stat -f %m "$output")
      if [ "$output_time" -ge "$trigger_time" ]; then
        break
      fi
    fi
    sleep 0.1
  done
}

print_output() {
  if [ -f "$output" ]; then
    cat "$output"
  fi
}

status_from_errors() {
  if [ -f "$output" ] && grep -q 'error:' "$output"; then
    return 1
  fi
  return 0
}

rebuild() {
  date +%s >"$trigger"
  wait_for_output
  print_output
  if status_from_errors; then
    return 0
  fi
  return 1
}

case "${1:-}" in
  --launch)
    shift
    launch_ghcid "$@"
    ;;
  --rebuild)
    rebuild
    ;;
  *)
    printf 'usage: %s --launch <ghcid args...> | --rebuild\n' "$0" >&2
    exit 2
    ;;
esac
